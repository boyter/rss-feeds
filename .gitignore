__pycache__/
*.log

# The pending product: rebuild.py --write puts it here, --apply moves it over
# feeds.json. Never committed, because you are meant to read it first.
feeds.json.new

# Working files the pipeline regenerates on every pass. The ones that are
# committed (harvest.jsonl, overrides.jsonl, spam.jsonl, candidates.jsonl) are
# evidence or human decisions; these are derived from them.
data/draft.jsonl
data/triage.jsonl
data/probe_results.jsonl
data/NEEDS_REVIEW.md
data/TRIAGE.md
data/DISCOVERY_REVIEW.md
data/DISCOVERY_UNTAGGED.md

# Fetched copies of the curated lists in data/sources.txt - derived, re-fetchable.
data/sources/

# Candidate lists discover.py generates from data/sources.txt. Derived: the
# sources, the fetched copies and probe_results.jsonl are the evidence.
data/candidates.discovered.jsonl
data/candidates.paths.jsonl
data/candidates.siblings.jsonl
data/candidates.leads.jsonl
data/candidates.amp.jsonl
data/candidates.oracle.jsonl
data/candidates.pages.jsonl
data/candidates.tagged.jsonl
data/DISCOVERY_UNTAGGED.jsonl
# decide.py batch inputs: transient. data/overrides.jsonl is the record of a
# hand decision; the batch file that produced it, and the reasons written in its
# comments, stay in git history (see the commits that applied each batch).
discovery-decisions*.txt
